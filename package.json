  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install && cd server && npm install && cd ../frontend && npm install",
    "start": "concurrently \"npm run start:server\" \"npm run start:frontend\"",
    "start:server": "npm --prefix server run start",
    "start:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run start:server\" \"npm run start:frontend\"",
    "build": "cd frontend && npm install && npm run build"
  },
  "dependencies": {
    "concurrently": "^10.0.5"
  }
}
